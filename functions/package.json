{
  "name": "functions",
  "packageManager": "pnpm@10.30.3",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": ">=10.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "lint": "eslint --cache src/",
    "lint-fix": "eslint --cache --fix src/ && prettier --write src/",
    "build": "tsc",
    "serve": "pnpm lint && pnpm build && firebase emulators:start --only functions",
    "shell": "pnpm build && firebase functions:shell",
    "start": "pnpm lint && pnpm shell",
    "deploy": "pnpm lint && firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google-cloud/firestore": "^6.6.1",
    "algoliasearch": "^4.8.3",
    "firebase": "^9.15.0",
    "firebase-admin": "^11.4.1",
    "firebase-functions": "^5.1.1",
    "firebase-tools": "^11.22.0",
    "html-to-text": "^8.2.1",
    "twitter": "^1.7.1"
  },
  "devDependencies": {
    "@types/html-to-text": "^8.1.1",
    "@types/twitter": "^1.7.1",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    "eslint": "^7.6.0",
    "eslint-plugin-import": "^2.22.0",
    "prettier": "^2.8.8",
    "typescript": "~4.9.4"
  },
  "private": true
}
